ENVIRONMENT=development
PORT=8001
BASE_URL=http://localhost:8001
FRONTEND_ORIGIN=http://localhost:5173
# Required in production: comma-separated API hosts, for example
# api.base64ops.example,api-staging.base64ops.example
TRUSTED_HOSTS=
# Use managed Redis in production so rate limits work across API instances.
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_REQUESTS_PER_MINUTE=8
# Set true in production after Redis is provisioned: do not allow token-heavy
# traffic through when the shared limiter is unavailable.
RATE_LIMIT_FAIL_CLOSED=false
# Set only to a single-IP header that your trusted edge overwrites. Never use
# X-Forwarded-For. Render's Cloudflare edge supplies CF-Connecting-IP.
TRUSTED_CLIENT_IP_HEADER=
# Development-only guard for the in-process limiter. Production requires Redis.
RATE_LIMIT_LOCAL_MAX_KEYS=10000
MAX_REQUEST_BODY_BYTES=1500000
# One active graph run per tenant prevents parallel browser tabs from
# multiplying inference cost. A Redis-backed lease is required at scale.
MAX_CONCURRENT_AGENT_RUNS_PER_TENANT=1
AGENT_RUN_LEASE_SECONDS=900
# Inline preserves the local developer experience. Render production uses the
# indexer worker and queues clone/index jobs away from API requests.
INDEXING_MODE=inline
BACKGROUND_JOB_MAX_ATTEMPTS=2
# Renewed by workers while a server-created job runs. A short expiry permits
# recovery after a crashed/force-stopped worker without duplicate active jobs.
BACKGROUND_JOB_LEASE_SECONDS=900
# Read-only delivery follow-up: only an Actions run whose SHA equals the
# delivered commit can produce a passed/failed result.
CI_VERIFICATION_POLL_SECONDS=60
CI_VERIFICATION_MAX_POLLS=20
# on_read avoids an always-on observer worker for the MVP. The Code commits
# rail reads the delivered branch's Actions status on its normal refresh.
CI_VERIFICATION_MODE=queued
# Browser session reads are intentionally local by default. Users can refresh
# CI explicitly, while the post-delivery worker verifies delivered commits.
CI_AUTO_REFRESH_SECONDS=0
# Monthly server-enforced limits for token-expensive repository agent runs.
# Billing webhooks can grant a paid tier; clients cannot alter these limits.
FREE_MONTHLY_AGENT_RUNS=25
PRO_MONTHLY_AGENT_RUNS=500
TEAM_MONTHLY_AGENT_RUNS=2000
# Safety ceilings for provider-reported usage, not billing prices. A model run
# is denied once the prior observed usage reaches the tier's monthly budget.
FREE_MONTHLY_MODEL_TOKENS=250000
PRO_MONTHLY_MODEL_TOKENS=5000000
TEAM_MONTHLY_MODEL_TOKENS=25000000
AGENT_RUN_IDEMPOTENCY_TTL_SECONDS=604800

# Razorpay subscriptions. Never expose RAZORPAY_KEY_SECRET or the webhook
# secret to Vercel/client variables. Create the two recurring plans in the
# Razorpay dashboard, then copy only their server-side IDs here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_TEAM_PLAN_ID=

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGO_DB_NAME=langgraph_devops_agent
MONGO_CONNECT_MAX_RETRIES=2
# Keeps health checks available when Atlas/network connectivity is temporarily unavailable.
MONGO_CONNECT_TIMEOUT_MS=5000
# Bound each process' Atlas socket pool. Size the aggregate across all Render
# replicas, then add capacity deliberately rather than exhausting Atlas.
MONGO_MAX_POOL_SIZE=20
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_RECONNECT_INTERVAL_SECONDS=15

# Clerk — get these from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_replace-with-your-clerk-secret-key
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
# Required in production. It matches the Clerk Frontend API URL / JWT `iss`.
CLERK_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev
# Comma-separated browser origins allowed by the optional JWT `azp` claim.
# Include preview domains only if they are intentionally allowed to call this API.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Render may generate the OAuth-state secret, but the encryption setting must
# be an exact Fernet key. Generate it locally with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production rejects short state secrets and token encryption keys that are
# not URL-safe base64-encoded 32-byte Fernet keys.
GITHUB_OAUTH_STATE_SECRET=replace-with-a-base64-encoded-256-bit-secret
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-256-bit-fernet-key
# Leave empty for new deployments. During a one-time production migration from
# the previous passphrase-derived encryption, set the former key here until
# all users reconnect GitHub; it is decrypt-only and must be at least 32 bytes.
GITHUB_TOKEN_ENCRYPTION_LEGACY_KEY=
# Signed OAuth state is also stored by hash and consumed once. Keep this
# short enough that an abandoned browser authorization cannot be replayed.
GITHUB_OAUTH_STATE_TTL_SECONDS=600
# Cache repository display metadata for a minute; access is still checked live
# whenever a repository is selected for a session.
GITHUB_REPOSITORY_CACHE_TTL_SECONDS=60

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
# Deterministic answers handle common guide flows. Unknown product questions
# use this lower-cost model; production investigations use CHAT_MODEL instead.
SUPPORT_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_INDEX_NAME=devops_rag_index
# Set true only after creating a compatible Atlas vector-search index.
RAG_VECTOR_ENABLED=false
RAG_RETRIEVAL_LIMIT=6
RAG_INDEX_MAX_FILES=300
RAG_INDEX_MAX_TOTAL_BYTES=12000000
RAG_INDEX_MAX_CHUNKS=8000
# Hard bounds for model context/output. Full evidence remains persisted and
# replayable; only ranked, bounded excerpts enter the model prompt.
LLM_MAX_CONTEXT_CHARS=24000
LLM_MAX_SOURCE_CHARS=4000
LLM_MAX_PATCH_CANDIDATE_CHARS=16000
LLM_MAX_OUTPUT_TOKENS=1200
SUPPORT_MAX_OUTPUT_TOKENS=500
# Each external model request has a deadline and at most one transient retry.
# Keep retries low: they protect availability, but can otherwise multiply cost.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

WORKSPACE_ROOT=.workspaces
USE_DOCKER_WORKSPACES=false
# Use disabled on a shared host without an isolated Docker runtime. It never
# falls back to executing repository-controlled validators in the API process.
EXECUTION_MODE=docker-sandbox
WORKSPACE_DOCKER_IMAGE=python:3.13.5-slim
MAX_PATCH_FILES=8
MAX_PATCH_LINES=500
# Stricter budget for the automatic "Repair latest CI failure" flow. Larger
# deliberate changes must use the normal reviewed editor proposal instead.
CI_REPAIR_MAX_FILES=2
CI_REPAIR_MAX_LINES=80
MAX_PATCH_FILE_BYTES=500000
MAX_PATCH_CONTENT_BYTES=250000
