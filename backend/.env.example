ENVIRONMENT=development
PORT=8001
BASE_URL=http://localhost:8001
FRONTEND_ORIGIN=http://localhost:5173

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGO_DB_NAME=langgraph_devops_agent
MONGO_CONNECT_MAX_RETRIES=2
# Keeps health checks available when Atlas/network connectivity is temporarily unavailable.
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_RECONNECT_INTERVAL_SECONDS=15

# Clerk — get these from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_replace-with-your-clerk-secret-key
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
SUPPORT_MODEL=gpt-5.6-sol
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_INDEX_NAME=devops_rag_index
# Set true only after creating a compatible Atlas vector-search index.
RAG_VECTOR_ENABLED=false

WORKSPACE_ROOT=.workspaces
USE_DOCKER_WORKSPACES=false
# Use disabled on a shared host without an isolated Docker runtime. It never
# falls back to executing repository-controlled validators in the API process.
EXECUTION_MODE=docker-sandbox
WORKSPACE_DOCKER_IMAGE=python:3.13-slim
MAX_PATCH_FILES=8
MAX_PATCH_LINES=500
MAX_PATCH_FILE_BYTES=500000
MAX_PATCH_CONTENT_BYTES=250000
