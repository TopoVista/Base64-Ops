ENVIRONMENT=development
PORT=8000
BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGO_DB_NAME=langgraph_devops_agent
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=10080

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

OPENAI_API_KEY=
CHAT_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_INDEX_NAME=devops_rag_index

WORKSPACE_ROOT=.workspaces
USE_DOCKER_WORKSPACES=false
WORKSPACE_DOCKER_IMAGE=python:3.13-slim
